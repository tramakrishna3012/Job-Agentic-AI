# ==============================================================================
# Job Application Assistant (JAA) - Environment Configuration
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit your real .env file or credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Choose your LLM backend: "openai" or "gemini" (default: "openai")
# Easily switch back and forth with a single variable change!
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai

# OpenAI Configuration (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (used when LLM_PROVIDER=gemini)
# Get a free API key at Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Note: gemini-3.6-flash is the active free-tier model as of 2026.
# Re-verify this model name in Google AI Studio's model picker periodically as Google updates/retires tiers.
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# Google Drive OAuth Configuration
# Path to your downloaded OAuth 2.0 Client Secret JSON file from Google Cloud Console
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_SECRET_PATH=credentials.json
# Optional root folder ID or URL where company folders and tailored resumes will be saved
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_or_url_here

# ------------------------------------------------------------------------------
# Notifications: Option 1 (ntfy.sh - 100% Free, Zero Setup) [RECOMMENDED]
# 1. Pick any unique topic name (e.g. jaa_alerts_alex_9921)
# 2. Subscribe to it in your phone app (ntfy on Android/iOS) or browser at https://ntfy.sh/your_topic
# ------------------------------------------------------------------------------
NTFY_TOPIC=jaa_alerts_your_unique_topic_name
NTFY_SERVER=https://ntfy.sh

# ------------------------------------------------------------------------------
# Notifications: Option 2 (CallMeBot WhatsApp) [OPTIONAL]
# 1. Add CallMeBot on WhatsApp: +34 644 44 20 62 or +34 644 65 32 08
# 2. Send the message: "I allow callmebot to send me messages"
# ------------------------------------------------------------------------------
# CALLMEBOT_PHONE=+91XXXXXXXXXX
# CALLMEBOT_API_KEY=your_callmebot_api_key_here

# ------------------------------------------------------------------------------
# Notifications: Option 3 (Twilio WhatsApp) [OPTIONAL]
# ------------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# YOUR_WHATSAPP_TO=whatsapp:+1234567890

# ------------------------------------------------------------------------------
# Phase 1 Dashboard Authentication
# Bearer token required to access the tracking dashboard and REST API
# ------------------------------------------------------------------------------
DASHBOARD_TOKEN=your_secure_dashboard_token_here

# Pipeline Local Configuration
MASTER_RESUME_PATH=resume.yaml
DB_PATH=jaa.db
